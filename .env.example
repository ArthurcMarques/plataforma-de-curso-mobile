# Use apenas letras e numeros nesta senha (ela integra a URL PostgreSQL).
POSTGRES_PASSWORD=substituaPorUmaSenhaAleatoria
JWT_SECRET=substituaPorUmSegredoAleatorioLongo
API_PORT=3000
FRONTEND_PORT=8080
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=substituaPorUmaSenhaDoPainel
PGADMIN_PORT=5050
PRISMA_STUDIO_PORT=5555

# Painel Cloudflare Zero Trust > Networks > Tunnels > seu túnel > token (veja GUIA-DO-CODIGO.md ou o chat).
CLOUDFLARE_TUNNEL_TOKEN=substituaPeloTokenDoSeuTunel

# Hostname da rota do túnel apontando pro serviço "mobile" (Metro do mobile2), usado só com
# "docker compose --profile mobile up -d". Precisa bater com a rota criada no painel Cloudflare.
MOBILE_HOSTNAME=mobile.seudominio.com
